<mxfile host="app.diagrams.net" modified="2026-09-05T00:00:00.000Z" agent="5.0" version="24.0.0" etag="ecommerce-arch-001" type="device">
  <diagram name="E-Commerce Backend Architecture" id="arch-diagram">
    <mxGraphModel dx="1422" dy="799" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" jump="0" machine="1" math="0" shadow="0" lacrosse="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- CLIENT BOX -->
        <mxCell id="client" value="Client / Postman&#xa;(Frontend, Mobile, API Client)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0074D9;strokeColor=#005A9E;fontColor=#FFFFFF;fontSize=14;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="30" width="180" height="70" as="geometry"/>
        </mxCell>

        <!-- CLIENT to EXPRESS arrow -->
        <mxCell id="arrow1" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="client" target="express">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="620" y="100" as="sourcePoint"/>
            <mxPoint x="620" y="140" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- EXPRESS SERVER BOX -->
        <mxCell id="express" value="Express API Server&#xa;← Render Cloud →" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=#388E3C;fontColor=#FFFFFF;fontSize=14;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="140" width="260" height="160" as="geometry"/>
        </mxCell>

        <!-- Express internal: CORS, Helmet, Rate Limit, JSON -->
        <mxCell id="middleware-stack" value="Middleware Pipeline&#xa;• CORS (origin check)&#xa;• Helmet (security headers)&#xa;• Rate Limiting (100 req/15min)&#xa;• JSON body parsing (10kb limit)&#xa;• Trust Proxy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#A5D6A7;fontSize=11;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="510" y="155" width="220" height="130" as="geometry"/>
        </mxCell>

        <!-- Routes Layer -->
        <mxCell id="routes-layer" value="Routes Layer&#xa;• /api/auth&#xa;• /api/products&#xa;• /api/cart&#xa;• /api/orders&#xa;• /api/protected" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#FDD835;fontSize=11;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="510" y="310" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="arrow2" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="express" target="routes-layer">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="620" y="300" as="sourcePoint"/>
            <mxPoint x="620" y="310" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Controllers Layer -->
        <mxCell id="controllers-layer" value="Controllers Layer&#xa;• HTTP request handling&#xa;• Calls service layer&#xa;• Formats HTTP response&#xa;• NO business logic" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#FFB74D;fontSize=11;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="510" y="390" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="arrow3" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="routes-layer" target="controllers-layer">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="620" y="380" as="sourcePoint"/>
            <mxPoint x="620" y="390" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Services Layer -->
        <mxCell id="services-layer" value="Services Layer&#xa;• Business logic&#xa;• Prisma transactions&#xa;• Stock validation&#xa;• Price calculation&#xa;• NO HTTP/Express code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#FF8A65;fontSize=11;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="510" y="470" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="arrow4" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="controllers-layer" target="services-layer">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="620" y="460" as="sourcePoint"/>
            <mxPoint x="620" y="470" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Prisma ORM -->
        <mxCell id="prisma" value="Prisma ORM&#xa;• Data access abstraction&#xa;• Type-safe queries&#xa;• Connection pooling&#xa;• $transaction() support" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#BA68C8;fontSize=11;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="510" y="570" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="arrow5" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="services-layer" target="prisma">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="620" y="560" as="sourcePoint"/>
            <mxPoint x="620" y="570" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- PostgreSQL -->
        <mxCell id="postgres" value="PostgreSQL Database&#xa;← Render Managed →" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3F51B5;strokeColor=#303F9F;fontColor=#FFFFFF;fontSize=13;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="650" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="arrow6" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="prisma" target="postgres">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="620" y="640" as="sourcePoint"/>
            <mxPoint x="620" y="650" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Error Handling cross-cutting -->
        <mxCell id="error-handling" value="Error Handling (cross-cutting)&#xa;• Central error middleware&#xa;• AppError class&#xa;• Prisma error codes&#xa;• Consistent JSON errors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#EF5350;fontSize=10;fontColor=#333333;dashed=1;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="750" y="200" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Middleware (cross-cutting) -->
        <mxCell id="middleware-cross" value="Cross-Cutting Middleware&#xa;• authenticate (JWT)&#xa;• authorizeRole (RBAC)&#xa;• validate (Zod)&#xa;• authLimiter (rate limit)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B3E5FC;strokeColor=#0288D1;fontSize=10;fontColor=#333333;dashed=1;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="750" y="310" width="200" height="90" as="geometry"/>
        </mxCell>

        <!-- Title -->
        <mxCell id="title" value="E-Commerce Backend — System Architecture" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;fontColor=#333333;align=center;" vertex="1" parent="1">
          <mxGeometry x="390" y="0" width="460" height="30" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Database ERD" id="erd-diagram">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" jump="0" machine="1" math="0" shadow="0" lacrosse="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="erd-title" value="Database Entity Relationship Diagram (ERD)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;fontColor=#333333;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="0" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- USER -->
        <mxCell id="user-table" value="USER&#xa;──────────────────&#xa;id        UUID (PK, auto)&#xa;email     String (unique)&#xa;password  String (bcrypt)&#xa;role      Enum (USER/ADMIN)&#xa;createdAt DateTime&#xa;──────────────────&#xa;Relations:&#xa;  → Cart (1:N)&#xa;  → Order (1:N)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=11;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="180" height="155" as="geometry"/>
        </mxCell>

        <!-- PRODUCT -->
        <mxCell id="product-table" value="PRODUCT&#xa;──────────────────&#xa;id          UUID (PK, auto)&#xa;name        String&#xa;description String&#xa;price       Int&#xa;stock       Int&#xa;isActive    Boolean (default true)&#xa;createdAt   DateTime&#xa;──────────────────&#xa;Relations:&#xa;  → CartItem (1:N)&#xa;  → OrderItem (1:N)&#xa;Soft delete via isActive" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=11;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="280" y="60" width="200" height="155" as="geometry"/>
        </mxCell>

        <!-- CART -->
        <mxCell id="cart-table" value="CART&#xa;──────────────────&#xa;id        UUID (PK, auto)&#xa;userId    String (FK → User)&#xa;status    Enum (ACTIVE/CHECKED_OUT)&#xa;createdAt DateTime&#xa;──────────────────&#xa;Relations:&#xa;  → User (N:1)&#xa;  → CartItem (1:N)&#xa;One ACTIVE cart per user" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=11;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="530" y="60" width="200" height="135" as="geometry"/>
        </mxCell>

        <!-- CARTITEM -->
        <mxCell id="cartitem-table" value="CARTITEM&#xa;──────────────────&#xa;id        UUID (PK, auto)&#xa;cartId    String (FK → Cart)&#xa;productId String (FK → Product)&#xa;quantity  Int&#xa;price     Int (snapshot)&#xa;──────────────────&#xa;Unique: [cartId, productId]&#xa;Relations:&#xa;  → Cart (N:1)&#xa;  → Product (N:1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E91E63;fontSize=11;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="780" y="60" width="200" height="135" as="geometry"/>
        </mxCell>

        <!-- ORDER -->
        <mxCell id="order-table" value="ORDER&#xa;──────────────────&#xa;id              UUID (PK, auto)&#xa;userId          String (FK → User)&#xa;totalAmount     Int&#xa;paymentStatus   String (COD/PAID)&#xa;paymentIntentId String? (Razorpay ID)&#xa;status          Enum (lifecycle)&#xa;createdAt       DateTime&#xa;──────────────────&#xa;Relations:&#xa;  → User (N:1)&#xa;  → OrderItem (1:N)&#xa;Status: PLACED→CONFIRMED&#xa;  →SHIPPED→DELIVERED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00ACC1;fontSize=11;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="530" y="240" width="200" height="170" as="geometry"/>
        </mxCell>

        <!-- ORDERITEM -->
        <mxCell id="orderitem-table" value="ORDERITEM&#xa;──────────────────&#xa;id        UUID (PK, auto)&#xa;orderId   String (FK → Order)&#xa;productId String (FK → Product)&#xa;quantity  Int&#xa;price     Int (snapshot)&#xa;name      String? (snapshot)&#xa;──────────────────&#xa;Relations:&#xa;  → Order (N:1)&#xa;  → Product (N:1)&#xa;Snapshot of cart items at checkout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9C27B0;fontSize=11;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="780" y="240" width="200" height="155" as="geometry"/>
        </mxCell>

        <!-- ENUMS box -->
        <mxCell id="enums-box" value="ENUMS&#xa;──────────────────&#xa;Role: USER, ADMIN&#xa;CartStatus: ACTIVE, CHECKED_OUT&#xa;OrderStatus: PLACED, CONFIRMED,&#xa;  SHIPPED, DELIVERED, CANCELLED&#xa;──────────────────&#xa;Database-enforced valid values" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;fontSize=10;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="260" width="180" height="120" as="geometry"/>
        </mxCell>

        <!-- USER → CART relation arrow -->
        <mxCell id="rel-user-cart" value="1:N" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;fontColor=#555555;align=center;" edge="1" parent="1" source="user-table" target="cart-table">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="230" y="130" as="sourcePoint"/>
            <mxPoint x="530" y="130" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- USER → ORDER relation arrow -->
        <mxCell id="rel-user-order" value="1:N" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;fontColor=#555555;align=center;" edge="1" parent="1" source="user-table" target="order-table">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="210" y="180" as="sourcePoint"/>
            <mxPoint x="530" y="310" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- CART → CARTITEM relation arrow -->
        <mxCell id="rel-cart-cartitem" value="1:N" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;fontColor=#555555;align=center;" edge="1" parent="1" source="cart-table" target="cartitem-table">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="730" y="130" as="sourcePoint"/>
            <mxPoint x="780" y="130" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- PRODUCT → CARTITEM relation arrow -->
        <mxCell id="rel-product-cartitem" value="1:N" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;fontColor=#555555;align=center;" edge="1" parent="1" source="product-table" target="cartitem-table">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="480" y="160" as="sourcePoint"/>
            <mxPoint x="780" y="110" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ORDER → ORDERITEM relation arrow -->
        <mxCell id="rel-order-orderitem" value="1:N" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;fontColor=#555555;align=center;" edge="1" parent="1" source="order-table" target="orderitem-table">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="730" y="320" as="sourcePoint"/>
            <mxPoint x="780" y="320" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- PRODUCT → ORDERITEM relation arrow -->
        <mxCell id="rel-product-orderitem" value="1:N" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;fontColor=#555555;align=center;" edge="1" parent="1" source="product-table" target="orderitem-table">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="480" y="200" as="sourcePoint"/>
            <mxPoint x="780" y="300" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- CARTITEM → ORDERITEM conceptual arrow (checkout conversion) -->
        <mxCell id="rel-checkout" value="Checkout: CartItem → OrderItem&#xa;(cart items snapshot into order items)" style="dashed=1;endArrow=classic;html=1;strokeColor=#888888;strokeWidth=1.5;fontSize=9;fontColor=#888888;align=center;" edge="1" parent="1" source="cartitem-table" target="orderitem-table">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="880" y="200" as="sourcePoint"/>
            <mxPoint x="880" y="240" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Checkout Transaction Flow" id="checkout-flow">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" jump="0" machine="1" math="0" shadow="0" lacrosse="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="checkout-title" value="Checkout Transaction Flow (prisma.$transaction)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;fontColor=#333333;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="0" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="step1" value="① Find Active Cart&#xa;prisma.cart.findFirst({&#xa;  where: { userId, status: ACTIVE },&#xa;  include: { items: { include: { product } } }&#xa;})" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=10;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="200" height="90" as="geometry"/>
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="step2" value="② Validate Cart&#xa;• Cart exists?&#xa;• Has items?&#xa;→ If empty: throw AppError" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#FDD835;fontSize=10;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="290" y="50" width="160" height="70" as="geometry"/>
        </mxCell>

        <!-- Step 3: START TRANSACTION -->
        <mxCell id="step3-start" value="③ START TRANSACTION&#xa;prisma.$transaction(async (tx) =&gt; {" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#FF5722;fontSize=11;fontColor=#333333;bold=1;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="490" y="50" width="200" height="55" as="geometry"/>
        </mxCell>

        <!-- Step 3a -->
        <mxCell id="step3a" value="3a. Validate Stock &amp; Calculate Total&#xa;• Each item: product.isActive?&#xa;• Each item: stock ≥ quantity?&#xa;• totalAmount += price × qty" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=10;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="730" y="40" width="240" height="70" as="geometry"/>
        </mxCell>

        <!-- Step 3b -->
        <mxCell id="step3b" value="3b. Create Order&#xa;tx.order.create({&#xa;  data: { userId, totalAmount,&#xa;  paymentStatus: 'COD' }&#xa;})" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=10;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="165" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Step 3c -->
        <mxCell id="step3c" value="3c. Create OrderItems&#xa;for each cart item:&#xa;tx.orderItem.create({&#xa;  orderId, productId,&#xa;  quantity, price&#xa;})" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=10;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="165" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Step 3d -->
        <mxCell id="step3d" value="3d. Reduce Stock&#xa;for each cart item:&#xa;tx.product.update({&#xa;  stock: { decrement: qty }&#xa;})" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=10;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="540" y="165" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Step 3e -->
        <mxCell id="step3e" value="3e. Close Cart&#xa;tx.cart.update({&#xa;  status: 'CHECKED_OUT'&#xa;})" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=10;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="780" y="165" width="190" height="60" as="geometry"/>
        </mxCell>

        <!-- Step 3f -->
        <mxCell id="step3f" value="3f. Return Full Order&#xa;tx.order.findUnique({&#xa;  include: { items: { include: { product } } }&#xa;})" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=10;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="780" y="260" width="190" height="70" as="geometry"/>
        </mxCell>

        <!-- Step 4: END TRANSACTION -->
        <mxCell id="step4" value="④ END TRANSACTION&#xa;→ All changes committed atomically&#xa;→ If any step fails: full rollback" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#FF5722;fontSize=11;fontColor=#333333;bold=1;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="490" y="260" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- Step 5 -->
        <mxCell id="step5" value="⑤ Return Order to Client&#xa;HTTP 201 Created&#xa;{ id, totalAmount, status, items }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=10;fontColor=#333333;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="340" width="240" height="70" as="geometry"/>
        </mxCell>

        <!-- Rollback path -->
        <mxCell id="rollback" value="⚠️ On Error:&#xa;• Transaction auto-rolls back&#xa;• Stock NOT reduced&#xa;• Order NOT created&#xa;• Cart stays ACTIVE&#xa;• Error bubbles to error middleware" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;fontSize=10;fontColor=#333333;dashed=1;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="340" width="300" height="80" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="ch1" style="endArrow=classic;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="250" y="95" as="sourcePoint"/>
            <mxPoint x="290" y="85" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="ch2" style="endArrow=classic;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1" source="step2" target="step3-start">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="450" y="85" as="sourcePoint"/>
            <mxPoint x="490" y="75" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="ch3" style="endArrow=classic;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1" source="step3-start" target="step3a">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="690" y="75" as="sourcePoint"/>
            <mxPoint x="730" y="75" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="ch4" style="endArrow=classic;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1" source="step3-start" target="step3b">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="590" y="105" as="sourcePoint"/>
            <mxPoint x="610" y="165" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="ch5" style="endArrow=classic;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1" source="step3b" target="step3c">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="270" y="205" as="sourcePoint"/>
            <mxPoint x="300" y="205" as="targetPoint"/>
